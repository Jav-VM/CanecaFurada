# Plantilla de variables de las COPIAS DE SEGURIDAD (restic). Valores ficticios.
# En el VPS: cp .env.backup.example .env.backup && chmod 600 .env.backup  (nunca se versiona).
# Solo la recibe el contenedor de restic (servicios backup y restore-media), no la aplicación.
#
# IMPORTANTE: guarda RESTIC_PASSWORD también FUERA del servidor (gestor de contraseñas).
# Sin ella las copias no se pueden descifrar: si el VPS se pierde, se pierden con él.

# Destino externo (uno). Ejemplos:
#   S3 compatible:  s3:https://s3.eu-central-1.example.com/caneca-backups
#   Backblaze B2:   b2:caneca-backups:/vps
#   rest-server:    rest:https://usuario:contrasena@backup.example.com/caneca
RESTIC_REPOSITORY=s3:https://s3.example.com/caneca-backups
RESTIC_PASSWORD=cambia-por-una-contrasena-larga-y-aleatoria

# Credenciales del destino (las que correspondan). Usa una clave que SOLO pueda
# escribir en ese bucket; si el proveedor lo permite, con bloqueo de objetos.
AWS_ACCESS_KEY_ID=clave-ficticia
AWS_SECRET_ACCESS_KEY=secreto-ficticio
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
