# Variables FICTICIAS para la pila local de compose.dev.yaml (Fase 12).
# Solo para probar en tu equipo: nunca las uses en un servidor. En producción
# se usa .env.prod (plantilla en .env.prod.example), que no se versiona.

CANECA_ENV_FILE=deploy/dev.env
CANECA_BACKUP_ENV_FILE=deploy/dev-backup.env

# --- PostgreSQL (contenedor db) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=solo-local-superusuario-ficticio
APP_DB_NAME=caneca_furada
APP_DB_USER=caneca
APP_DB_PASSWORD=solo-local-app-ficticia

# --- Nginx ---
NGINX_SERVER_NAME=localhost
DJANGO_ADMIN_URL=admin-local/

# --- Django (config.settings.prod) ---
DJANGO_SECRET_KEY=solo-local-clave-ficticia-de-desarrollo-no-usar-en-servidores-0123456789
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
SITE_BASE_URL=https://localhost:8443
# Sin HSTS en local: el navegador lo recordaría para localhost.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# --- Correo: Mailpit (no envía nada fuera) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@example.com
