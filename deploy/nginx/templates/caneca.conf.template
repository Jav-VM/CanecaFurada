# Caneca Furada — Nginx delante de Gunicorn (Fase 12).
# Plantilla: la imagen oficial sustituye ${NGINX_SERVER_NAME} y ${DJANGO_ADMIN_URL}
# al arrancar. Las variables propias de Nginx (con $ y sin llaves) no se tocan.
# Ver docs/fase-12-despliegue.md.

server_tokens off;

# --- Logs sin datos sensibles ----------------------------------------------------
# Sin cabeceras (Authorization, Cookie), sin cuerpos, sin cadena de consulta y
# sin Referer. Los tokens que van en la ruta se sustituyen por [token].
map $uri $caneca_log_uri {
    ~^/cuenta/verificar-email/reenviar          $uri;
    ~^/cuenta/verificar-email/                  /cuenta/verificar-email/[token]/;
    ~^/cuenta/contrasena/restablecer/           /cuenta/contrasena/restablecer/[token]/;
    ~^/comunicaciones/baja/                     /comunicaciones/baja/[token]/;
    default                                     $uri;
}
log_format caneca '$remote_addr [$time_local] "$request_method $caneca_log_uri $server_protocol" '
                  '$status $body_bytes_sent $request_time "$http_user_agent"';
access_log /var/log/nginx/access.log caneca;

# --- Límite de peticiones (segunda capa; Django tiene sus propios límites) -------
# Más holgado que el de Django (30 fallos por IP) porque los clientes del local
# comparten la IP de la wifi.
limit_req_zone $binary_remote_addr zone=caneca_auth:10m rate=30r/m;
limit_req_status 429;

# `web` se resuelve de nuevo con el DNS de Docker: al recrear el contenedor (despliegue,
# rollback, restauración) cambia de IP y, sin esto, Nginx seguiría usando la antigua (502).
resolver 127.0.0.11 valid=10s ipv6=off;
upstream caneca_web {
    zone caneca_web 64k;
    server web:8000 resolve;
    keepalive 16;
}

# --- Peticiones a hosts desconocidos: se cierran sin respuesta ------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 444;
    }
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    # SNI válido pero otra cabecera Host: también se cierra.
    location / {
        return 444;
    }
}

# --- HTTP: reto de Let's Encrypt y redirección a HTTPS ----------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS -------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # Enlaces que gestiona /usr/local/bin/caneca-certs (Let's Encrypt o provisional).
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:caneca_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Imágenes de la carta: CATALOG_IMAGE_MAX_BYTES = 5 MB + el resto del formulario.
    client_max_body_size 6m;
    client_body_timeout 30s;

    # Estáticos con hash en el nombre (ManifestStaticFilesStorage): caché de un año.
    location /static/ {
        alias /srv/static/;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Ficheros subidos: solo imágenes (las extensiones que admite la carta), sin
    # ejecutar nada y sin listar directorios. Cualquier otra ruta de /media/ da 404.
    location ~* ^/media/(.+\.(?:jpe?g|png|webp))$ {
        alias /srv/media/$1;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    }
    location /media/ {
        return 404;
    }

    # El healthcheck es interno (contenedores); no se publica.
    location = /healthz {
        return 404;
    }

    # Login, registro, recuperación y reenvíos (web, admin y API).
    location ~ ^/(cuenta/(entrar|registro|contrasena/recuperar|verificar-email/reenviar)|api/v1/auth/(login|register|password/reset|email/resend|token/refresh))/$ {
        limit_req zone=caneca_auth burst=20 nodelay;
        include /etc/nginx/conf.d/caneca-proxy.inc;
    }
    location = /${DJANGO_ADMIN_URL}login/ {
        limit_req zone=caneca_auth burst=20 nodelay;
        include /etc/nginx/conf.d/caneca-proxy.inc;
    }

    location / {
        include /etc/nginx/conf.d/caneca-proxy.inc;
    }
}
