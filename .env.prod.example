# Plantilla de variables de PRODUCCIÓN (Fase 12). Todos los valores son ficticios.
# En el VPS: cp .env.prod.example .env.prod && chmod 600 .env.prod  (nunca se versiona).
# La usan Docker Compose (--env-file .env.prod) y los contenedores web, scheduler y migrate.
# Guía: docs/fase-12-despliegue.md
#
# Generar valores aleatorios (en el VPS):
#   openssl rand -hex 32        contraseñas de PostgreSQL (hex: no necesitan codificarse en la URL)
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   DJANGO_SECRET_KEY

# --- Dominio y Nginx ---
# Nombre(s) del servidor; el primero es el del certificado de Let's Encrypt.
NGINX_SERVER_NAME=www.example.com
# Ruta del admin técnico (terminada en /): no obvia. La usan Django y el límite de Nginx.
DJANGO_ADMIN_URL=gestion-ficticia-cambiar/

# --- PostgreSQL (contenedor db) ---
# Superusuario: solo administración, copias y restauración. La aplicación NO lo usa.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia-por-openssl-rand-hex-32
# Rol de la aplicación, sin privilegios especiales y propietario de su BD
# (lo crea deploy/postgres/10-app-role.sh al inicializar el volumen).
APP_DB_NAME=caneca_furada
APP_DB_USER=caneca
APP_DB_PASSWORD=cambia-por-openssl-rand-hex-32
# Fijadas en compose.yaml a partir de las anteriores (no hace falta definirlas):
#   DATABASE_URL, CACHE_URL=redis://redis:6379/1, DJANGO_BEHIND_TLS_PROXY=True, DJANGO_TRUSTED_PROXY_COUNT=1
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=True

# --- Django ---
DJANGO_SECRET_KEY=cambia-por-una-clave-aleatoria-de-al-menos-50-caracteres
DJANGO_ALLOWED_HOSTS=www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com
SITE_BASE_URL=https://www.example.com
DJANGO_LOG_LEVEL=INFO
# HSTS: 1 año. Preload desactivado a propósito (difícil de revertir).
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# --- Gunicorn (opcional) ---
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=30

# --- Correo (proveedor SMTP real; credenciales solo aquí) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=usuario-ficticio
EMAIL_HOST_PASSWORD=cambia-por-la-del-proveedor
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Caneca Furada <no-reply@example.com>

# --- Notificaciones ---
SMS_BACKEND=
NOTIFICATIONS_BATCH_SIZE=200

# --- API de la app ---
API_ACCESS_TOKEN_MINUTES=15
API_REFRESH_TOKEN_DAYS=30
# Clave propia para los JWT (opcional, ≥ 32 bytes): permite rotar DJANGO_SECRET_KEY
# sin cerrar las sesiones de la app.
# API_JWT_SIGNING_KEY=
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=240/min
API_THROTTLE_AUTH=10/min
API_DOCS_PUBLIC=False

# --- Primer propietario: NO las dejes aquí ---
# Se pasan solo al ejecutar create_owner (ver docs/fase-12-despliegue.md, «Primer despliegue»).
