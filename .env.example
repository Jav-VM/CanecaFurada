# Copia este fichero como .env y ajusta los valores. Nunca subas .env al repositorio.
# Todos los valores de ejemplo son ficticios.

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ruta del admin técnico (terminada en /). En producción usa una ruta no obvia.
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO

# --- Base de datos ---
# PostgreSQL. Obligatoria en producción (config.settings.prod rechaza SQLite).
# Si se omite, en desarrollo y tests se usa SQLite (db.sqlite3).
# Caracteres especiales de la contraseña codificados (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# Si PostgreSQL está en otro servidor, añade ?sslmode=verify-full.
# Guía: docs/migracion-postgresql.md
# DATABASE_URL=postgres://caneca:contrasena-ficticia@localhost:5432/caneca_furada
# Segundos que se reutiliza una conexión (0 = una por petición; p. ej. 60 en el VPS).
DATABASE_CONN_MAX_AGE=0
# Comprueba la conexión antes de reutilizarla (recomendado si DATABASE_CONN_MAX_AGE > 0).
DATABASE_CONN_HEALTH_CHECKS=False

# --- Email ---
# Desarrollo: si no se define EMAIL_BACKEND, los emails se muestran en la consola.
# Para un SMTP local de pruebas (p. ej. Mailpit en localhost:1025):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=localhost
#   EMAIL_PORT=1025
#   EMAIL_USE_TLS=False
# Producción: SMTP real obligatorio; los backends de consola/memoria/fichero/nulo se rechazan.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario-ficticio
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Notificaciones (Fase 10) ---
# SMS opcional: ruta a la clase del proveedor. Vacío = SMS desactivado (no hay proveedor integrado).
# Al integrar uno, sus credenciales irán en variables propias (nunca en el repositorio).
SMS_BACKEND=
# Notificaciones que envía cada ejecución de `process_notifications`.
NOTIFICATIONS_BATCH_SIZE=200

# URL pública del sitio para los enlaces de los emails (https obligatorio en producción).
SITE_BASE_URL=http://localhost:8000

# --- Cuentas de cliente ---
# Caducidad del enlace de verificación de email (horas) y edad mínima de registro.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
ACCOUNTS_MIN_CUSTOMER_AGE=18

# --- Proxy inverso (Fase 11) ---
# Número de proxies de confianza delante de Django que añaden X-Forwarded-For.
# 0 = ninguno (se usa REMOTE_ADDR). Nunca pongas más de los que hay de verdad.
DJANGO_TRUSTED_PROXY_COUNT=0

# --- API REST v1 para la app móvil (Fase 11) ---
# Duración de los tokens de la app.
API_ACCESS_TOKEN_MINUTES=15
API_REFRESH_TOKEN_DAYS=30
# Clave propia para firmar los JWT (opcional; si se omite se usa DJANGO_SECRET_KEY).
# Mínimo 32 bytes en producción. Cambiarla cierra todas las sesiones de la app.
# API_JWT_SIGNING_KEY=
# Límites de peticiones (formato DRF: N/sec|min|hour|day).
API_THROTTLE_ANON=60/min
API_THROTTLE_USER=240/min
API_THROTTLE_AUTH=10/min
# Documentación /api/v1/docs/ sin sesión (True por defecto solo en desarrollo).
# API_DOCS_PUBLIC=False

# --- Caché (límite de intentos de login) ---
# En producción con varios procesos, usa una caché compartida, p. ej.:
# CACHE_URL=redis://localhost:6379/1
# CACHE_URL=dbcache://django_cache   (requiere python manage.py createcachetable)

# --- Solo producción (config.settings.prod) ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False
# DJANGO_BEHIND_TLS_PROXY=False

# --- Creación no interactiva del primer propietario (create_owner --noinput) ---
# Defínelas solo durante la ejecución del comando y elimínalas después.
# CANECA_OWNER_EMAIL=propietario@example.com
# CANECA_OWNER_FIRST_NAME=Nombre
# CANECA_OWNER_LAST_NAME=Apellidos
# CANECA_OWNER_PASSWORD=
